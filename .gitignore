# secrets (keep only the template). Order matters: the negations come last.
.env
.env.*
*.env
.envrc
*.pem
*.key
*.p12
*.pfx
service-account*.json
.claude/settings.local.json
!.env.example
!**/.env.example

# database dumps and backups (they hold the data; never commit them)
*.dump
*.sql.gz
backups/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# generated output
reports/
data/demo/*.json

# node / frontend (built by `make ui`; never committed)
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# os / editor
.DS_Store
.idea/
.vscode/

# draft PDFs stay local, except the ones under docs/
*.pdf
!docs/**/*.pdf
