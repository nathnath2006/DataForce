# Copy to backend/.env and lock it down:
#   cp backend/.env.example backend/.env && chmod 600 backend/.env
# backend/.env is gitignored. NEVER commit real keys, and never paste them in chat or logs.
#
# Every Settings field (backend/app/config.py) is listed, in UPPER_CASE. Lines starting with
# "# " show the built-in default: uncomment one only to override it. Secrets have no value here
# on purpose, and are commented out because an empty `KEY=` would be read as an empty secret
# instead of "not set".

# --- environment -----------------------------------------------------------------------------
# One of: dev | test | demo
# dev / test: local conveniences (default dataforce:dataforce database credentials, http://localhost
#   endpoints, a group-readable .env only logs a warning).
# demo (any shared / hosted run): the app REFUSES TO START with the default or a placeholder /
#   short (< 8 chars) database password, with an http:// endpoint, or with a .env that is
#   readable by group/others (chmod 600 backend/.env).
# ENVIRONMENT=dev

# --- database --------------------------------------------------------------------------------
# Default matches docker-compose.yml (Postgres 16 + pgvector on 127.0.0.1:5433, dev-only
# credentials). If you change POSTGRES_PASSWORD for docker compose, change it here too, and note
# that the Postgres image applies POSTGRES_PASSWORD only when the data volume is first created
# (see README "Changing the database password").
# Hosted (Supabase): a dedicated database role, URL-encoded password, and TLS. A non-loopback
# host WITHOUT sslmode=require|verify-ca|verify-full is rejected at startup:
#   DATABASE_URL=postgresql+psycopg://dataforce_app:URL-ENCODED-PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# Stricter (also stops a man-in-the-middle; download the project's CA from the dashboard):
#   ...?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt
# Supabase transaction pooler (port 6543): prepared statements are switched off automatically.
# Pass the URL through this variable, never on a command line (`alembic -x db_url=...` shows the
# password in `ps` and in your shell history).
# DATABASE_URL=postgresql+psycopg://dataforce:dataforce@localhost:5433/dataforce
# Used by the integration tests only (database created by docker/postgres/init/01-init.sql).
# tests/conftest.py refuses a name that does not end with _test, one equal to the DATABASE_URL
# database, and a non-loopback host (unless ALLOW_REMOTE_TEST_DB=1 is set in the environment).
# TEST_DATABASE_URL=postgresql+psycopg://dataforce:dataforce@localhost:5433/dataforce_test
# Hosting storage cap in MB (Supabase free tier = 500); `dataforce stats db` reports usage against it.
# DB_QUOTA_MB=500
# Seconds to wait for a connection before giving up (a dead network must not hang a command).
# DB_CONNECT_TIMEOUT_S=10
# Per-transaction limits in milliseconds (0 = no limit): a runaway query is cancelled, and a
# row lock held by another session is waited for at most this long.
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=15000
# Turn psycopg3 server-side prepared statements off (needed behind a transaction pooler such as
# Supabase port 6543; switched on automatically for that port).
# DB_DISABLE_PREPARED_STATEMENTS=false

# --- LLM / embeddings ------------------------------------------------------------------------
# LLM_PROVIDER: gemini | anthropic | fake   (fake = offline demos, no key needed)
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER: gemini | fake
# EMBEDDING_PROVIDER=gemini
# Secret. Get one at https://aistudio.google.com/apikey then uncomment and paste it:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must equal the pgvector column size (768). Changing it requires a migration.
# EMBEDDING_DIM=768
# Secret, only needed when LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_S=60.0
# LLM_MAX_CONCURRENCY=4
# Spend ceiling: max LLM calls per run.
# LLM_MAX_CALLS_PER_RUN=2000

# --- stats engine: "not verified" gates ------------------------------------------------------
# STATS_CONFIDENCE=0.95
# Benjamini-Hochberg false discovery rate across a scan.
# STATS_FDR_ALPHA=0.05
# GATE_MIN_N=30
# GATE_MIN_WINS=10
# GATE_MIN_LOSSES=10
# GATE_MAX_CI_HALFWIDTH_PTS=15.0
# GATE_MAX_CI_REL_HALFWIDTH=0.30
# STATS_BOOTSTRAP_RESAMPLES=2000
# STATS_RANDOM_SEED=42

# --- synthetic demo data -----------------------------------------------------------------------
# DEMO_SEED=42
# DEMO_N_DEALS=350

# --- enrichment (people contact data; paid lookups only on an explicit click) -----------------
# ENRICHMENT_PROVIDER: tamtam_mcp | fake | none (headless use; the UI decides per workspace)
# ENRICHMENT_PROVIDER=none
# TAMTAM_MCP_URL=https://api.tamtam.ai/mcp
# Normally empty: connect TamTam from the UI (Settings > Connect TamTam). Only for headless use,
# a pasted bearer token:
# TAMTAM_MCP_TOKEN=
# Hard ceiling of credits per enrichment call.
# ENRICHMENT_MAX_CREDITS_PER_CALL=10.0
# Authorization servers accepted for TamTam's OAuth (JSON list of exact origins).
# TAMTAM_OAUTH_ALLOWED_ISSUERS=["https://api.tamtam.ai"]

# --- local web UI (loopback only; no login before M3) ------------------------------------------
# Seals connector tokens and enriched contact values at rest. Do not paste one by hand:
# `make ui` (or `dataforce secrets init`) writes it here. Losing it means reconnecting TamTam.
# DATAFORCE_SECRET_KEY=
# UI_HOST=127.0.0.1
# UI_PORT=8800
# Origins allowed to send changes (JSON list); 5173 is the Vite dev server of `make ui-dev`.
# UI_ALLOWED_ORIGINS=["http://127.0.0.1:8800","http://localhost:8800","http://127.0.0.1:5173","http://localhost:5173"]
# Built frontend served at / (default: ../frontend/dist).
# UI_DIST_DIR=

# --- M2a: analysis flows, company registry, AI assistant ---------------------------------------
# Largest file accepted by the dataset block (bytes; default 20 MB).
# UPLOAD_MAX_BYTES=20971520
# Rows read per dataset / produced per block.
# FLOW_MAX_ROWS=200000
# FLOW_RUN_TIMEOUT_S=60
# Flow runs allowed at the same time.
# FLOW_MAX_CONCURRENT_RUNS=2
# Query timeout for external PostgreSQL connections (seconds).
# DATA_CONNECTION_TIMEOUT_S=30
# Public French company registry used by the Companies tab (no key needed).
# REGISTRY_URL=https://recherche-entreprises.api.gouv.fr
# The AI model and its key are set per workspace in the UI (Settings > AI model), not here.
# ASSISTANT_MAX_OUTPUT_TOKENS=800
# ASSISTANT_MAX_CONTEXT_CHARS=40000
# Ask-panel questions allowed per workspace and hour (cost guard).
# ASSISTANT_MAX_ASKS_PER_HOUR=60
